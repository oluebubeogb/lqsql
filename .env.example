# ---- required ----
# postgres://user:password@host:5432/db  |  mysql://user:password@host:3306/db  |  sqlite:////data/app.db
DATABASE_URL=postgres://user:password@my-postgres-host:5432/mydb
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# ---- optional ----
# postgresql | mysql | sqlite  (inferred from DATABASE_URL when empty)
SQL_TYPE=
# public URL; https here turns on Secure cookies
# subdomain mode:  APP_URL=https://sql.collab.name.ng   (ROOT_PATH empty)
# path mode:       APP_URL=https://existing.collab.name.ng/litesql  + ROOT_PATH=/litesql
APP_URL=https://sql.collab.name.ng
# optional sub-path to serve under, e.g. /litesql (empty = domain root)
ROOT_PATH=
READ_ONLY=false
IMPORT_MAX_MB=25
QUERY_TIMEOUT_SECONDS=30
PAGE_SIZE_DEFAULT=50
# cookie signing key; derived from the admin credentials when empty
SECRET_KEY=
# container listen port; leave unset on Coolify (proxy targets 80). Local publish port for the commented `ports:` mapping:
# PORT=80
# HOST_PORT=6789
